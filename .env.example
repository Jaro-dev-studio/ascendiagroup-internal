# --- CRM meeting recorder (Recall.ai + Google Workspace) ---
# Service account key JSON, raw or base64. Needs domain-wide delegation for
# calendar, gmail.send, gmail.readonly, admin.directory.user.readonly
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_WORKSPACE_DOMAIN="jaro.dev"
# Region must match the region the API key was issued in
RECALL_API_KEY=""
RECALL_REGION="us-east-1"
# Workspace verification secret from Recall's Developers > API Keys & Secrets
# page (whsec_...). Legacy per-endpoint Svix secrets also work.
RECALL_WEBHOOK_SECRET=""
# --- AI chat (text agent + realtime voice mode + web search) ---
# Also used to mint the short lived tokens the browser needs for voice mode, and
# to run the hosted web search tool. No separate search provider is needed.
OPENAI_API_KEY=""
# Optional override for the model that runs web searches; defaults to gpt-5-mini.
# It has to be a model the Responses web search tool supports.
OPENAI_WEB_SEARCH_MODEL=""
# Optional overrides for voice mode; defaults are gpt-realtime, the marin voice
# and English. The language is passed to the transcriber, which invents words
# when it is left to guess from silence.
OPENAI_REALTIME_MODEL=""
OPENAI_REALTIME_VOICE=""
OPENAI_REALTIME_LANGUAGE=""

# Shared bearer token for /api/cron/* endpoints. Vercel sends it automatically on
# scheduled invocations; without it the endpoints accept any caller.
CRON_SECRET=""
# Public origin used to build unsubscribe and click-tracking links in sequence
# emails. Falls back to NEXTAUTH_URL, then localhost.
NEXT_PUBLIC_APP_URL=""
