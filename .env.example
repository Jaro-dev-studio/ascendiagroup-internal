# --- Database (Vercel Postgres / Neon) ---
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# --- Auth ---
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 32+ character secret used to encrypt integration credentials at rest.
# Falls back to NEXTAUTH_SECRET when unset.
APP_ENCRYPTION_KEY=""

# --- Optional integration fallbacks ---
# Every integration is normally connected from Settings > Integrations and its
# credentials are stored encrypted in the database. These env vars are only used
# as a fallback when no integration record exists.
ANTHROPIC_API_KEY=""

# Shared token that /api/webhooks/* endpoints require as ?token= or
# x-webhook-token. Generated automatically when the WhatsApp or call recording
# integration is connected; set here to pin a fixed value.
WEBHOOK_TOKEN=""
