generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ---------------------------------------------------------------------------
// People & access
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  ACCOUNT_MANAGER
  SPECIALIST
  CLIENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  jobTitle  String?
  phone     String?
  image     String?
  role      UserRole @default(ACCOUNT_MANAGER)
  isActive  Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managedClients   Client[]              @relation("ClientAccountManager")
  clientAccess     Client[]              @relation("ClientPortalUser")
  ownedProjects    Project[]             @relation("ProjectOwner")
  assignedTasks    Task[]                @relation("TaskAssignee")
  createdForms     OnboardingForm[]
  createdStrategies Strategy[]
  createdDocuments KnowledgeDocument[]
  conversations    ClaudeConversation[]
  createdMeetings  Meeting[]
  invitesSent      TeamInvite[]          @relation("InviteSender")
  integrations     Integration[]
  activities       ActivityLog[]

  @@index([role])
}

model TeamInvite {
  id         String    @id @default(cuid())
  email      String
  role       UserRole  @default(ACCOUNT_MANAGER)
  token      String    @unique
  message    String?
  invitedById String
  invitedBy  User      @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([token])
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

enum ClientStatus {
  LEAD
  ONBOARDING
  ACTIVE
  PAUSED
  CHURNED
}

enum ServiceLine {
  SEO
  GOOGLE_ADS
  META_ADS
  WEBSITE
  GOOGLE_BUSINESS_PROFILE
  SOCIAL_MEDIA
  CONTENT
  REPUTATION
  CRM_AUTOMATION
}

model Client {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  practiceType   String?
  website        String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  whatsappNumber String?
  addressLine    String?
  city           String?
  country        String?
  packageTier    String?
  status         ClientStatus @default(ONBOARDING)
  monthlyRetainer Float?
  startDate      DateTime?
  notes          String?
  portalToken    String       @unique

  accountManagerId String?
  accountManager   User?   @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)

  portalUserId String?
  portalUser   User?   @relation("ClientPortalUser", fields: [portalUserId], references: [id], onDelete: SetNull)

  driveFolderUrl   String?
  trelloBoardId    String?
  trelloBoardUrl   String?
  claudeProjectId  String?
  claudeProjectUrl String?
  claudeSyncedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services         ClientService[]
  integrationLinks ClientIntegrationLink[]
  submissions      OnboardingSubmission[]
  projects      Project[]
  tasks         Task[]
  strategies    Strategy[]
  documents     KnowledgeDocument[]
  meetings      Meeting[]
  whatsapp      WhatsAppMessage[]
  conversations ClaudeConversation[]
  metrics       ClientMetric[]
  reports       Report[]
  activities    ActivityLog[]

  @@index([status])
  @@index([accountManagerId])
}

/// Per-client identifier inside a connected third party (campaign id, ad
/// account id, GHL location, ...) used when syncing reporting data.
model ClientIntegrationLink {
  id         String              @id @default(cuid())
  clientId   String
  client     Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  provider   IntegrationProvider
  externalId String
  label      String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([clientId, provider])
}

model ClientService {
  id        String      @id @default(cuid())
  clientId  String
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service   ServiceLine
  createdAt DateTime    @default(now())

  @@unique([clientId, service])
}

// ---------------------------------------------------------------------------
// Onboarding forms (with split decision-tree logic)
// ---------------------------------------------------------------------------

enum FieldType {
  SHORT_TEXT
  LONG_TEXT
  EMAIL
  PHONE
  URL
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
  CREDENTIAL
  FILE_LINK
  SERVICE_SELECT
}

enum ConditionOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  IS_ANY_OF
}

model OnboardingForm {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  intro       String?
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields      OnboardingFormField[]
  submissions OnboardingSubmission[]
}

model OnboardingFormField {
  id       String    @id @default(cuid())
  formId   String
  form     OnboardingForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  section  String    @default("General")
  label    String
  helpText String?
  type     FieldType @default(SHORT_TEXT)
  options  String[]  @default([])
  isRequired Boolean @default(false)
  isCredential Boolean @default(false)
  order    Int       @default(0)

  conditionalFieldId String?
  conditionalField   OnboardingFormField? @relation("FieldCondition", fields: [conditionalFieldId], references: [id], onDelete: SetNull)
  dependents         OnboardingFormField[] @relation("FieldCondition")
  conditionOperator  ConditionOperator?
  conditionValues    String[]             @default([])

  answers OnboardingAnswer[]

  @@index([formId])
}

enum SubmissionStatus {
  INVITED
  SUBMITTED
  PROCESSED
}

model OnboardingSubmission {
  id           String           @id @default(cuid())
  formId       String
  form         OnboardingForm   @relation(fields: [formId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  token        String           @unique
  status       SubmissionStatus @default(INVITED)
  practiceName String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  invitedAt    DateTime         @default(now())
  submittedAt  DateTime?
  processedAt  DateTime?
  projectId    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  answers    OnboardingAnswer[]
  strategies Strategy[]

  @@index([status])
}

model OnboardingAnswer {
  id           String               @id @default(cuid())
  submissionId String
  submission   OnboardingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fieldId      String
  field        OnboardingFormField  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  label        String
  section      String               @default("General")
  value        String?
  values       String[]             @default([])
  isCredential Boolean              @default(false)
  createdAt    DateTime             @default(now())

  @@unique([submissionId, fieldId])
}

// ---------------------------------------------------------------------------
// Delivery: projects & tasks
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

model Project {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  dueDate     DateTime?
  ownerId     String?
  owner       User?         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  trelloBoardId  String?
  trelloBoardUrl String?
  driveFolderUrl String?
  sourceSubmissionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks      Task[]
  strategies Strategy[]
  activities ActivityLog[]

  @@index([clientId])
  @@index([status])
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskSource {
  MANUAL
  ONBOARDING
  STRATEGY
  MEETING
  TEMPLATE
  AUTOMATION
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  position    Int          @default(0)
  source      TaskSource   @default(MANUAL)
  sourceRef   String?
  trelloCardId String?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  strategyItems StrategyItem[]
  meetingItems  MeetingActionItem[]

  @@index([projectId])
  @@index([clientId])
  @@index([assigneeId])
  @@index([status])
}

model TaskTemplate {
  id          String       @id @default(cuid())
  name        String
  description String?
  service     ServiceLine?
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items           TaskTemplateItem[]
  automationRules AutomationRule[]
}

model TaskTemplateItem {
  id          String       @id @default(cuid())
  templateId  String
  template    TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  description String?
  offsetDays  Int          @default(0)
  priority    TaskPriority @default(MEDIUM)
  order       Int          @default(0)
}

enum AutomationTrigger {
  ONBOARDING_SUBMITTED
  PROJECT_CREATED
  RECURRING_WEEKLY
  RECURRING_MONTHLY
}

model AutomationRule {
  id         String            @id @default(cuid())
  name       String
  trigger    AutomationTrigger
  templateId String?
  template   TaskTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  isActive   Boolean           @default(true)
  lastRunAt  DateTime?
  runCount   Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

// ---------------------------------------------------------------------------
// 90 day strategy
// ---------------------------------------------------------------------------

enum StrategyStatus {
  DRAFT
  IN_REVIEW
  APPROVED
}

enum StrategyPhaseKey {
  DAY_30
  DAY_60
  DAY_90
}

model Strategy {
  id          String         @id @default(cuid())
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  status      StrategyStatus @default(DRAFT)
  summary     String?
  positioning String?
  audience    String?
  risks       String?
  model       String?
  sourceSubmissionId String?
  sourceSubmission   OnboardingSubmission? @relation(fields: [sourceSubmissionId], references: [id], onDelete: SetNull)
  sourceMeetingIds   String[]              @default([])
  generatedAt DateTime?
  approvedAt  DateTime?
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  phases StrategyPhase[]

  @@index([clientId])
}

model StrategyPhase {
  id         String           @id @default(cuid())
  strategyId String
  strategy   Strategy         @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  phase      StrategyPhaseKey
  title      String
  objective  String?
  order      Int              @default(0)

  items StrategyItem[]

  @@unique([strategyId, phase])
}

model StrategyItem {
  id          String        @id @default(cuid())
  phaseId     String
  phase       StrategyPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String?
  owner       String?
  priority    TaskPriority  @default(MEDIUM)
  order       Int           @default(0)
  taskId      String?
  task        Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Knowledge base & Claude
// ---------------------------------------------------------------------------

enum DocumentSource {
  ONBOARDING
  TRANSCRIPT
  WHATSAPP
  MANUAL
  STRATEGY
  INTEGRATION
}

model KnowledgeDocument {
  id          String         @id @default(cuid())
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  source      DocumentSource @default(MANUAL)
  sourceRef   String?
  content     String
  summary     String?
  tags        String[]       @default([])
  claudeFileId String?
  syncedAt    DateTime?
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([clientId])
  @@index([source])
}

model ClaudeConversation {
  id          String   @id @default(cuid())
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String   @default("New conversation")
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages ClaudeMessage[]

  @@index([clientId])
}

enum ChatRole {
  USER
  ASSISTANT
}

model ClaudeMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   ClaudeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String
  contextTitles  String[]           @default([])
  createdAt      DateTime           @default(now())

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Meetings & WhatsApp
// ---------------------------------------------------------------------------

enum MeetingType {
  SALES_CALL
  ONBOARDING_CALL
  STRATEGY_CALL
  CHECK_IN
  OTHER
}

enum MeetingSource {
  MANUAL
  UPLOAD
  RECORDING_WEBHOOK
}

model Meeting {
  id              String        @id @default(cuid())
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title           String
  type            MeetingType   @default(SALES_CALL)
  occurredAt      DateTime
  durationMinutes Int?
  attendees       String[]      @default([])
  transcript      String?
  summary         String?
  nextSteps       String?
  recordingUrl    String?
  source          MeetingSource @default(MANUAL)
  externalId      String?       @unique
  summarizedAt    DateTime?
  createdById     String?
  createdBy       User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  actionItems MeetingActionItem[]

  @@index([clientId])
}

model MeetingActionItem {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title     String
  owner     String?
  dueDate   DateTime?
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model WhatsAppMessage {
  id          String           @id @default(cuid())
  clientId    String?
  client      Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  externalId  String?          @unique
  direction   MessageDirection @default(INBOUND)
  fromNumber  String
  toNumber    String?
  senderName  String?
  body        String?
  mediaUrl    String?
  mediaType   String?
  sentAt      DateTime
  documentId  String?
  createdAt   DateTime         @default(now())

  @@index([clientId])
  @@index([sentAt])
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

enum IntegrationProvider {
  CLAUDE
  TRELLO
  WHATSAPP
  CALL_RECORDING
  GOOGLE_DRIVE
  GOOGLE_BUSINESS_PROFILE
  GOOGLE_ADS
  AGENCY_ANALYTICS
  SEMRUSH
  GOHIGHLEVEL
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

model Integration {
  id            String              @id @default(cuid())
  provider      IntegrationProvider @unique
  status        IntegrationStatus   @default(DISCONNECTED)
  credentials   String?
  settings      Json?
  accountLabel  String?
  lastCheckedAt DateTime?
  lastSyncedAt  DateTime?
  lastError     String?
  connectedById String?
  connectedBy   User?               @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

// ---------------------------------------------------------------------------
// Reporting
// ---------------------------------------------------------------------------

model ClientMetric {
  id          String              @id @default(cuid())
  clientId    String
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  provider    IntegrationProvider
  metricKey   String
  label       String
  value       Float
  unit        String?
  periodStart DateTime
  periodEnd   DateTime
  capturedAt  DateTime            @default(now())

  @@unique([clientId, provider, metricKey, periodStart])
  @@index([clientId])
}

enum ReportType {
  WEEKLY
  MONTHLY
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

model Report {
  id          String       @id @default(cuid())
  clientId    String
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  type        ReportType   @default(MONTHLY)
  status      ReportStatus @default(DRAFT)
  periodStart DateTime
  periodEnd   DateTime
  summary     String?
  highlights  String[]     @default([])
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Activity timeline
// ---------------------------------------------------------------------------

enum ActivityType {
  CLIENT_CREATED
  ONBOARDING_INVITED
  ONBOARDING_SUBMITTED
  PROJECT_CREATED
  TASK_CREATED
  TASK_COMPLETED
  STRATEGY_GENERATED
  DOCUMENT_ADDED
  MEETING_LOGGED
  WHATSAPP_RECEIVED
  INTEGRATION_UPDATED
  REPORT_PUBLISHED
  NOTE
}

model ActivityLog {
  id          String       @id @default(cuid())
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actorId     String?
  actor       User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type        ActivityType
  title       String
  description String?
  link        String?
  createdAt   DateTime     @default(now())

  @@index([clientId])
  @@index([createdAt])
}
